{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Medict",
  "version": "0.1.0",
  "identifier": "com.medict.desktop.tauri",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Medict",
        "width": 420,
        "height": 610,
        "minWidth": 360,
        "minHeight": 300,
        "maxWidth": 560,
        "maxHeight": 780,
        "decorations": false,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "devtools": false,
        "browserExtensionsEnabled": false,
        "additionalBrowserArgs": "--disable-gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; media-src https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src https: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../../build/SelectionHelper.exe"],
    "icon": ["icons/medict.ico"]
  }
}
